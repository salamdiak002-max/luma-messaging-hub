# Nom : .env.example | Chemin : /.env.example
# Backend Python uniquement — ne jamais committer le vrai fichier .env

# Chemin vers la clé de service Firebase Admin (JSON téléchargé depuis la console)
GOOGLE_APPLICATION_CREDENTIALS=./backend/serviceAccountKey.json
FIREBASE_PROJECT_ID=votre-projet

# Origines autorisées pour CORS
ALLOWED_ORIGINS=http://localhost:8080,https://votre-projet.web.app

# IA LUMA (préparation — la clé reste côté serveur uniquement)
AI_API_KEY=
AI_API_URL=

FLASK_ENV=development
PORT=8000
